{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mosaic Stockholm camera",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "latitude", "longitude", "type", "operator", "status", "orientation", "horizontal_fov", "range_m", "geometry_confidence", "geometry_provenance", "viewable", "feed", "source_ids", "confidence", "last_verified"],
  "properties": {
    "id": {"type": "string", "pattern": "^camera-[a-z0-9-]+$"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "type": {"enum": ["traffic", "municipal", "police", "public_transport", "road_monitoring", "other"]},
    "operator": {"type": ["string", "null"]},
    "status": {"enum": ["active", "inactive", "unknown", "deprecated"]},
    "orientation": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360},
    "horizontal_fov": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 360},
    "range_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "geometry_confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "geometry_provenance": {"enum": ["official", "documented", "approximate", "unknown"]},
    "viewable": {"type": "boolean"},
    "feed": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["type", "url", "access", "evidence_source_id"],
          "properties": {
            "type": {"enum": ["hls", "webrtc", "mjpeg", "image", "embed"]},
            "url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "access": {"const": "public"},
            "evidence_source_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low", "pending_review"]},
    "last_verified": {"type": "string", "format": "date"},
    "source_native_id": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"}
  },
  "allOf": [
    {"if": {"properties": {"viewable": {"const": true}}}, "then": {"properties": {"feed": {"type": "object"}}}},
    {"if": {"properties": {"viewable": {"const": false}}}, "then": {"properties": {"feed": {"type": "null"}}}}
  ]
}
