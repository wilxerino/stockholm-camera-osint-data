{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mosaic mapped ATM location",
  "type": "object",
  "required": ["id", "latitude", "longitude", "source_url", "source_ids", "camera_presence"],
  "properties": {
    "id": {"type": "string", "pattern": "^atm-"},
    "latitude": {"type": "number", "minimum": 59, "maximum": 59.6},
    "longitude": {"type": "number", "minimum": 17.5, "maximum": 18.6},
    "name": {"type": ["string", "null"]},
    "operator": {"type": ["string", "null"]},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "camera_presence": {"enum": ["unknown", "documented"]}
  }
}
